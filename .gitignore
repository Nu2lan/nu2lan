# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Editor and OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# NOTE: cache/ is deliberately NOT ignored.
# today.py keeps its per-repo LOC cache there and the workflow commits updates to it,
# so ignoring that directory would break the incremental LOC counts.
