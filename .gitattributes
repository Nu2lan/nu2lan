# Normalize line endings to LF everywhere.
# You edit on Windows, the workflow runs on Ubuntu and commits back — without this,
# a clone with core.autocrlf unset could commit CRLF and produce whole-file diffs.
* text=auto eol=lf

# Files generated by today.py: collapse them in diffs and keep them out of the
# repository's language statistics. cache/requirements.txt is hand-maintained and
# is deliberately not matched by the pattern below (it does not start with a hex digit).
dark_mode.svg     linguist-generated=true
light_mode.svg    linguist-generated=true
cache/[0-9a-f]*.txt linguist-generated=true

# Binary assets, should they ever be added
*.png binary
*.jpg binary
*.gif binary
*.ico binary
